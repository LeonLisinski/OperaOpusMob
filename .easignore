/ionic.config.json
/vite.config.ts
/index.html
/cypress.config.ts
/tsconfig.json
/tsconfig.node.json
/package.json
/package-lock.json
/yarn.lock
/.browserslistrc
/.eslintrc.js
/.cursorignore
/.nx/

